# 三裁判配置示例
# 复制本文件为 judges.yaml 并填入真实 API key（judges.yaml 已在 .gitignore 中，不会提交）
# 或使用环境变量：DEEPSEEK_API_KEY / ARK_API_KEY / DASHSCOPE_API_KEY

scoring_mode: strict   # strict | soft

deepseek:
  api_key: ""                      # 或环境变量 DEEPSEEK_API_KEY
  model: "deepseek-v4-pro"         # 裁判用 pro；M_A补充用 deepseek-v4-flash（更便宜）

doubao:
  api_key: ""                      # 或环境变量 ARK_API_KEY（火山方舟）
  model: "<推理接入点 endpoint_id>" # 豆包需填推理接入点ID，非模型名

qwen:
  api_key: ""                      # 或环境变量 DASHSCOPE_API_KEY（阿里百炼）
  model: "qwen3.7-plus"
